# ---------------------------------------------------------------
# RaceSafe backend configuration
# Copy this file to ".env" (same folder) and fill in your password:
#     Copy-Item .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=racesafe

# Database used by pytest (created and wiped automatically by the tests)
TEST_DB_NAME=racesafe_test

# "development" enables demo-only endpoints (failure injection, race lab,
# data reset). Set to "production" to disable them.
RACESAFE_ENV=development

# Concurrency settings (the design document assumes 8 workers, 3 attempts)
WORKER_COUNT=8
MAX_ATTEMPTS=3
PER_COURSE_IN_FLIGHT=1
MAX_QUEUE_SIZE=5000
SCHEDULER_MODE=FAIR_QUEUE

# Optional artificial work (milliseconds) inside each registration
# transaction for normal traffic. Keep 0 for real timings.
SIMULATED_WORK_MS=0

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
